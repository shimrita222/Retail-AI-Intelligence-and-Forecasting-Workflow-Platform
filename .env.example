# Environment variable NAMES only -- no real values. Copy to .env locally
# (.env is already gitignored) and fill in real values there; never commit
# real values under any of these names.

# --- Existing (Phase 1/2/3) ---
OPENAI_API_KEY=

# --- Phase 4A: Supabase ---
# FRONTEND-SAFE / RUNTIME. Local dev values come from `supabase status`
# after `supabase start`; staging values come from the staging Supabase
# project settings. Safe to ship to a browser-facing build.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# BACKEND-ONLY / RUNTIME. Bypasses Row Level Security. Never set this in
# any frontend-reachable config, never log it, never pass it to a CrewAI
# agent. Only src/persistence/supabase_client.py's build_service_role_client()
# may read this variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4B: Streamlit authentication mode ---
# supabase | legacy -- selects which login gate app.py uses. Default
# (unset/empty) is "supabase" -- the target system. Any other value
# fails closed (the app refuses to render any login form at all); it
# never falls back to legacy automatically. Set to "legacy" only to
# explicitly use the temporary config.yaml + SHA-256 path during the
# Supabase migration.
AUTH_MODE=supabase

# --- App/environment identity ---
# local | staging | production -- must match workflow_runs.source_environment.
APP_ENV=local
ARTIFACT_ROOT=artifacts
